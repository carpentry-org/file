(load "file.carp")
(load "Test.carp")

(use-all File Test Result)

(def test-acc 0)

(defn- clean-walk-fixture []
  (do
    (ignore (System.system "chmod -R u+rwx walk-fixture 2> /dev/null"))
    (ignore (System.system "rm -rf walk-fixture"))))

(defn- make-walk-fixture []
  (do
    (clean-walk-fixture)
    (ignore (System.system "mkdir -p walk-fixture/readable walk-fixture/locked"))
    (ignore
      (System.system
        "touch walk-fixture/top walk-fixture/readable/inner walk-fixture/locked/deep"))))

; chmod 000 does not stop root, so probe the directory instead of assuming
(defn- locked-dir-unreadable? []
  (let [d (Dir.open (cstr "walk-fixture/locked"))]
    (if (null? d) true (do (Dir.close d) false))))

(defn- make-read-fixture []
  (let-do [f (unsafe-from-success (File.open-with "read-fixture" "w+"))]
    (ignore (File.write &f "hello"))
    (File.close f)))

(defn- read-chars [n]
  (let-do [f (unsafe-from-success (File.open-with "read-fixture" "r"))
           res (the (Result String String) (File.read &f n))]
    (File.close f)
    res))

(defn- read-bytes [n]
  (let-do [f (unsafe-from-success (File.open-with "read-fixture" "r"))
           res (the (Result (Array Byte) String) (File.read &f n))]
    (File.close f)
    res))

(defn- read-at-most [n]
  (let-do [f (unsafe-from-success (File.open-with "read-fixture" "r"))
           res (File.ByteReader.read-at-most &f n)]
    (File.close f)
    res))

(defn- byte-count [res]
  (match res (Result.Success b) (Array.length &b) (Result.Error _) -1))

(defn- bytes-of [res] (match res (Result.Success b) b (Result.Error _) []))

; reading a 5-byte file in 2-byte chunks: the last chunk is short, and
; the one after it is empty
(defn- chunked-read []
  (let-do [f (unsafe-from-success (File.open-with "read-fixture" "r"))
           acc []
           go true]
    (while go
      (match (File.ByteReader.read-at-most &f 2)
        (Result.Success chunk)
          (if (Array.empty? &chunk)
            (set! go false)
            (set! acc (Array.push-back acc (Array.length &chunk))))
        (Result.Error _) (set! go false)))
    (File.close f)
    acc))

; the backgrounded writer blocks on open until the test opens the read end
(defn- make-fifo []
  (= 0
     (System.system
       "rm -f read-fifo; mkfifo read-fifo && (printf abc > read-fifo &)")))

(defn- fifo-read-all-error? []
  (let-do [f (unsafe-from-success (File.open-with "read-fifo" "r"))
           res (error? &(the (Result String String) (File.read-all &f)))]
    (File.close f)
    res))

; /dev/full takes a buffered write and then fails to flush; Linux only
(defn- have-dev-full? []
  (match (File.open-with "/dev/full" "w")
    (Result.Success f) (do (File.close f) true)
    (Result.Error _) false))

(defn- flush-dev-full []
  (let-do [f (unsafe-from-success (File.open-with "/dev/full" "w"))
           wrote (File.write &f "hello")
           flushed (File.flush &f)]
    (File.close f)
    [(error? &wrote) (error? &flushed)]))

(defn- close-dev-full []
  (let-do [f (unsafe-from-success (File.open-with "/dev/full" "w"))
           -wrote (File.write &f "hello")]
    (File.close-checked f)))

(defn- flush-then-close-dev-full []
  (let-do [f (unsafe-from-success (File.open-with "/dev/full" "w"))
           -wrote (File.write &f "hello")
           flushed (File.flush &f)]
    [flushed (File.close-checked f)]))

(defn- flush-twice-dev-full []
  (let-do [f (unsafe-from-success (File.open-with "/dev/full" "w"))
           -wrote (File.write &f "hello")
           first (File.flush &f)
           second (File.flush &f)]
    (File.close f)
    [first second]))

(defn- flush-rewrite-flush-dev-full []
  (let-do [f (unsafe-from-success (File.open-with "/dev/full" "w"))
           -wrote (File.write &f "hello")
           first (File.flush &f)
           -rewrote (File.write &f "world")
           second (File.flush &f)]
    (File.close f)
    [first second]))

(defn- flush-rewrite-close-dev-full []
  (let-do [f (unsafe-from-success (File.open-with "/dev/full" "w"))
           -wrote (File.write &f "hello")
           flushed (File.flush &f)
           -rewrote (File.write &f "world")]
    [flushed (File.close-checked f)]))

(defn- flush-failure []
  (the (Result () String)
       (Result.Error @"The file “/dev/full” could not be flushed")))

(defn- close-failure []
  (the (Result () String)
       (Result.Error @"The file “/dev/full” could not be closed")))

(defn- sticky-failure []
  (the (Result () String)
       (Result.Error @"The file “/dev/full” had an earlier write failure")))

(defn- flush-and-close-writable []
  (let-do [f (unsafe-from-success (File.open-with "flush-fixture" "w"))
           wrote (File.write &f "hello")
           flushed (File.flush &f)
           again (File.flush &f)]
    [(error? &wrote)
     (error? &flushed)
     (error? &again)
     (error? &(File.close-checked f))]))

(defn- remove-again []
  (let-do [f (unsafe-from-success (File.open "remove-fixture"))
           -first (File.remove &f)
           res (File.remove &f)]
    (File.close f)
    res))

(defn- remove-twice []
  (let-do [f (unsafe-from-success (File.open "remove-fixture"))
           gone (File.remove &f)
           again (File.remove &f)]
    (File.close f)
    [(error? &gone) (error? &again)]))

(defn main []
  (with-test test
    (assert-equal test
      "hi"
      &(let-do [f (unsafe-from-success (File.open "example"))
                s @""]
        (ignore (File.write &f "hi"))
        (set! s (unsafe-from-success (File.read-all &f)))
        (File.close f)
        s)
      "reading and writing works")
    (assert-true test
      (let [f (unsafe-from-success (File.open "example"))] (File.writable? &f))
      "writable? works I")
    (assert-false test
      (let [f (unsafe-from-success (File.open-with "example" "r"))]
        (File.writable? &f))
      "writable? works II")
    (assert-true test
      (let [f (unsafe-from-success (File.open-with "example" "r+"))]
        (File.writable? &f))
      "writable? works for r+ mode")
    (assert-true test
      (let [f (unsafe-from-success (File.open-with "example" "r+"))]
        (File.readable? &f))
      "readable? works for r+ mode")
    (assert-equal test
      "hello"
      &(let-do [f (unsafe-from-success (File.open-with "example" "w+"))
                s @""]
        (ignore (File.write &f "hello"))
        (File.rewind &f)
        (set! s (unsafe-from-success (File.read-all &f)))
        (File.close f)
        s)
      "open-with uses single fopen (read-write round-trip)")
    (assert-true test
      (let [f (unsafe-from-success (File.open "example"))] (File.readable? &f))
      "readable? works I")
    (assert-false test
      (let [f (unsafe-from-success (File.open-with "example" "w"))]
        (File.readable? &f))
      "readable? works II")
    (assert-true test
      (let [f (unsafe-from-success (File.open-with "example" "rb"))]
        (File.binary-mode? &f))
      "binary-mode? works I")
    (assert-false test
      (let [f (unsafe-from-success (File.open "example"))]
        (File.binary-mode? &f))
      "binary-mode? works II")
    (assert-true test
      (let [f (File.open-with "doesntexist" "r")] (error? &f))
      "opening non-existent file returns Result.Error")
    (assert-equal test
      &(Result.Error @"Can’t open 'doesntexist'")
      &(File.walk "doesntexist" &(fn [s] ()))
      "opening non-existent directory returns Result.Error")
    (assert-equal test
      2
      (do
        (ignore (File.walk "test" &(fn [_] (set! test-acc (+ test-acc 1)))))
        test-acc)
      "walk works on directory")
    (do (set! test-acc 0) @test)
    (assert-equal test
      3
      (do
        (ignore
          (File.walk-with "test"
                          &(fn [_] (set! test-acc (+ test-acc 1)))
                          &(WalkOptions.init true false false true)))
        test-acc)
      "walk-with works on directory")
    (assert-equal test
      &(Array.sorted &[@"./test/nested/fixture" @"./test/file.carp"])
      &(Array.sorted
        &(Result.from-success (File.map "test" &(fn [s] (fmt "./%s" s))) []))
      "map works on directory")
    (assert-equal test
      &(Array.sorted &[@"test/nested/fixture" @"test/file.carp"])
      &(Array.sorted &(Result.from-success (File.contents "test") []))
      "contents works on directory")
    (do (make-walk-fixture) @test)
    (assert-equal test
      &(Array.sorted
        &[@"walk-fixture/locked/deep"
          @"walk-fixture/readable/inner"
          @"walk-fixture/top"])
      &(Array.sorted &(Result.from-success (File.contents "walk-fixture") []))
      "walk visits every file of a readable tree")
    (assert-true test
      (do
        (ignore (System.system "chmod 000 walk-fixture/locked"))
        (if (locked-dir-unreadable?)
          (error? &(File.walk "walk-fixture" &(fn [_] ())))
          (do
            (IO.println "\t(skipped, unreadable directories are not enforced)")
            true)))
      "walk reports an error for an unreadable subdirectory")
    (do (clean-walk-fixture) @test)
    (do (make-read-fixture) @test)
    (assert-equal test
      &(Result.Success @"hello")
      &(read-chars 5)
      "the string reader reads a full-length request")
    (assert-equal test
      5
      (byte-count (read-bytes 5))
      "the byte reader reads a full-length request")
    (assert-equal test
      &(Result.Error
        @"Expected 20 characters from the file “read-fixture”, but got 5")
      &(read-chars 20)
      "the string reader reports a short read as an error")
    (assert-equal test
      &(Result.Error
        @"Expected 20 bytes from the file “read-fixture”, but got 5")
      &(read-bytes 20)
      "the byte reader reports a short read as an error")
    (assert-equal test
      &(Result.Error
        @"Can’t read -1 characters from the file “read-fixture”")
      &(read-chars -1)
      "the string reader rejects a negative length")
    (assert-equal test
      &(Result.Error @"Can’t read -1 bytes from the file “read-fixture”")
      &(read-bytes -1)
      "the byte reader rejects a negative length")
    (assert-equal test
      &(Result.Success @"")
      &(read-chars 0)
      "the string reader reads nothing for a length of zero")
    (assert-equal test
      0
      (byte-count (read-bytes 0))
      "the byte reader reads nothing for a length of zero")
    (assert-equal test
      5
      (byte-count (read-at-most 5))
      "read-at-most reads a full-length request whole")
    (assert-equal test
      3
      (byte-count (read-at-most 3))
      "read-at-most reads less than the file holds")
    (assert-equal test
      5
      (byte-count (read-at-most 20))
      "read-at-most returns a short read instead of erroring")
    (assert-equal test
      &[104b 101b 108b 108b 111b]
      &(bytes-of (read-at-most 20))
      "a short read from read-at-most holds the bytes that were there")
    (assert-equal test
      0
      (byte-count (read-at-most 0))
      "read-at-most reads nothing for a length of zero")
    (assert-equal test
      &(Result.Error @"Can’t read -1 bytes from the file “read-fixture”")
      &(read-at-most -1)
      "read-at-most rejects a negative length")
    (assert-equal test
      &[2 2 1]
      &(chunked-read)
      "read-at-most reads a file in chunks, short final chunk included")
    (assert-true test
      (let-do [f (unsafe-from-success (File.open-with "write-fixture" "w"))
               res (error? &(File.ByteReader.read-at-most &f 4))]
        (File.close f)
        (ignore (System.system "rm -f write-fixture"))
        res)
      "read-at-most reports an unreadable file rather than reading nothing")
    (assert-true test
      (if (make-fifo)
        (fifo-read-all-error?)
        (do (IO.println "\t(skipped, named pipes are not supported)") true))
      "read-all reports an error for an unseekable stream")
    (do (ignore (System.system "rm -f read-fixture read-fifo")) @test)
    (assert-equal test
      &[false true]
      &(remove-twice)
      "remove reports an error for a file that is already gone")
    (assert-equal test
      &(Result.Error @"The file “remove-fixture” could not be removed")
      &(remove-again)
      "a failed remove names the file")
    (assert-equal test
      &[false true]
      &(if (have-dev-full?)
        (flush-dev-full)
        (do
          (IO.println "\t(skipped, no unwritable device available)")
          [false true]))
      "write succeeds into the buffer but flush reports the failed write")
    (assert-equal test
      &(close-failure)
      &(if (have-dev-full?)
        (close-dev-full)
        (do
          (IO.println "\t(skipped, no unwritable device available)")
          (close-failure)))
      "close-checked names the close when the close is what fails")
    (assert-equal test
      &[(flush-failure) (sticky-failure)]
      &(if (have-dev-full?)
        (flush-then-close-dev-full)
        (do
          (IO.println "\t(skipped, no unwritable device available)")
          [(flush-failure) (sticky-failure)]))
      "close-checked names the earlier failure a preceding flush drained")
    (assert-equal test
      &[(flush-failure) (sticky-failure)]
      &(if (have-dev-full?)
        (flush-twice-dev-full)
        (do
          (IO.println "\t(skipped, no unwritable device available)")
          [(flush-failure) (sticky-failure)]))
      "a second flush names the earlier failure the first one drained")
    (assert-equal test
      &[(flush-failure) (flush-failure)]
      &(if (have-dev-full?)
        (flush-rewrite-flush-dev-full)
        (do
          (IO.println "\t(skipped, no unwritable device available)")
          [(flush-failure) (flush-failure)]))
      "a flush with new data to lose names itself, not the earlier failure")
    (assert-equal test
      &[(flush-failure) (close-failure)]
      &(if (have-dev-full?)
        (flush-rewrite-close-dev-full)
        (do
          (IO.println "\t(skipped, no unwritable device available)")
          [(flush-failure) (close-failure)]))
      "a close with new data to lose names itself, not the earlier failure")
    (assert-equal test
      &[false false false false]
      &(flush-and-close-writable)
      "flush and close-checked succeed on a file that takes the write")
    (do (ignore (System.system "rm -f flush-fixture")) @test)
    (let-do [f (unsafe-from-success (File.open "example"))]
      (ignore (File.remove &f))
      @test)))
